# Copy to .env beside docker-compose.yml. The name needs a DNS record
# pointing at this host before the first start.
JITPACK_HOST=jitpack.example.com

# Your user name, and the hash of your password:
#   docker run --rm caddy:2.11.6-alpine caddy hash-password --plaintext 'your password'
# Put the hash in single quotes: it contains $ signs.
BASIC_AUTH_USER=me
BASIC_AUTH_HASH=''

# The time zone for task reminders, e.g. Europe/Zurich.
TZ=UTC
