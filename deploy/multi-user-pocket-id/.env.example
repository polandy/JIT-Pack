# Copy to .env beside docker-compose.yml. Both names need a DNS record
# pointing at this host before the first start.
JITPACK_HOST=jitpack.example.com
AUTH_HOST=auth.example.com

# Generate each once: openssl rand -hex 32 / openssl rand -base64 32
JITPACK_SESSION_SECRET=
POCKET_ID_ENCRYPTION_KEY=

# From the OIDC client you create in Pocket ID (step 3 of the walkthrough).
JITPACK_OIDC_CLIENT_ID=
JITPACK_OIDC_CLIENT_SECRET=

# Your own address, as entered in Pocket ID.
JITPACK_ADMIN_EMAILS=you@example.com

# The time zone for task reminders, e.g. Europe/Zurich.
TZ=UTC
